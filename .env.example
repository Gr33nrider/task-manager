# App
APP_NAME="Your-app-name"
APP_DESCRIPTION="Your-description"
APP_VERSION="1.0"
SECRET_KEY="your-secret-key-here-change-in-production"

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_manager
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@task_manager_db:5433/${POSTGRES_DB}

# Test database (only for tests)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@task_manager_db:5433/task_manager_test

# JWT
JWT_SECRET_KEY=${SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# GigaChat
GIGACHAT_CREDENTIALS="your-gigachat-credentials-here"
GIGACHAT_SCOPE="GIGACHAT_API_PERS"
GIGACHAT_MODEL="GigaChat"
GIGACHAT_TEMPERATURE=0.1

# Celery
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@task_manager_db:5433/${POSTGRES_DB}